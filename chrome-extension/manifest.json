{
  "manifest_version": 3,
  "name": "Rx to Google Reminder - 1-Tap Prescription Sync",
  "version": "1.0.0",
  "description": "Extract medication schedules from PDF prescriptions and set Google Reminders with one tap.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Rx to Google Reminder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
